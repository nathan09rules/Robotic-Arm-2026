<?xml version="1.0"?>
<robot name="four_dof_arm">

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.05"/>
      </geometry>
    </visual>
  </link>

  <!-- CH14: base rotation about Z -->
  <link name="base_yaw_link"/>

  <joint name="joint_14" type="revolute">
    <parent link="base_link"/>
    <child link="base_yaw_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57079632679" upper="1.57079632679"
           effort="5" velocity="2"/>
  </joint>

  <!-- CH13: shoulder about X, at the same origin as CH14 -->
  <link name="upper_arm_link">
    <visual>
      <origin xyz="0 0 0.0525" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.012" length="0.105"/>
      </geometry>
    </visual>
  </link>

  <joint name="joint_13" type="revolute">
    <parent link="base_yaw_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="1.57079632679"
           effort="5" velocity="2"/>
  </joint>

  <!-- 10.5 cm from CH13 to CH15 -->
  <link name="forearm_link">
    <visual>
      <origin xyz="0 0 0.0625" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.011" length="0.125"/>
      </geometry>
    </visual>
  </link>

  <joint name="joint_15" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0 0.105" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="1.57079632679"
           effort="5" velocity="2"/>
  </joint>

  <!-- 12.5 cm from CH15 to CH4 -->
  <link name="wrist_link">
    <visual>
      <origin xyz="0 0 0.07" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.009" length="0.14"/>
      </geometry>
    </visual>
  </link>

  <joint name="joint_4" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_link"/>
    <origin xyz="0 0 0.125" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="1.57079632679"
           effort="5" velocity="2"/>
  </joint>

  <!-- 14 cm from CH4 to the end effector -->
  <link name="end_effector_link">
    <visual>
      <geometry>
        <sphere radius="0.012"/>
      </geometry>
    </visual>
  </link>

  <joint name="tool_fixed" type="fixed">
    <parent link="wrist_link"/>
    <child link="end_effector_link"/>
    <origin xyz="0 0 0.14" rpy="0 0 0"/>
  </joint>

</robot>

